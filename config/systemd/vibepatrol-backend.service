[Unit]
Description=VibePatrol Flask Backend
After=network.target

[Service]
User=beasty197
Group=beasty197
WorkingDirectory=/home/beasty197/projects/vibepatrol/backend
Environment="PATH=/home/beasty197/projects/vibepatrol/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/beasty197/projects/vibepatrol/.venv/bin/gunicorn -w 4 -b 0.0.0.0:5003 wsgi:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target